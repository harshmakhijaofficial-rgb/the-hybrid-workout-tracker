        {
          "id": "tue_legpress",
          "name": "Leg Press",
          "sets": 3,
          "reps": "8–12",
          "rest": 120,
          "style": "Bear top + 2 back-offs",
          "tip": "Controlled depth; do not lock knees harshly."
        },
        {
          "id": "tue_rdl",
          "name": "Dumbbell Romanian Deadlift",
          "sets": 2,
          "reps": "8–12",
          "rest": 120,
          "style": "Controlled",
          "tip": "Hinge hips back, spine neutral."
