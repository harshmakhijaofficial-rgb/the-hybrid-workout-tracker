{
  "name": "THE HYBRID",
  "subheading": "BEAR × HEAVY DUTY × GOLDEN ERA",
  "description": "Four weeks of progressive hypertrophy, controlled strength and StairMaster conditioning, on a Tuesday–Monday training cycle.",
  "start_date": "2026-10-20",
  "weeks": [
    {
      "week": 1,
      "label": "FOUNDATION",
      "rule": "Use the listed working sets if recovery permits, leaving 2–3 reps in reserve. Reduce a set if soreness is excessive."
    },
    {
      "week": 2,
      "label": "BUILD",
      "rule": "Use the prescribed sets if recovering well. Aim for about 2 reps in reserve."
    },
    {
      "week": 3,
      "label": "INTENSITY",
      "rule": "Keep listed sets, apply Bear back-offs selectively; one safe isolation set near technical failure."
    },
    {
      "week": 4,
      "label": "CONSOLIDATE",
      "rule": "Maintain volume, improve clean reps or modestly increase weights. Do not chase failure everywhere."
    }
  ],
  "days": [
    {
      "day": "Tuesday",
      "short": "TUE",
      "focus": "Chest + Back A",
      "tag": "THE BEAR · STRENGTH",
      "cardio_target": 15,
      "cardio_intensity": "Moderate",
      "exercises": [
        {
          "id": "mon_chest_press",
          "name": "Machine Chest Press",
          "sets": 3,
          "reps": "6–10",
          "rest": 120,
          "style": "Bear top + 2 back-offs",
          "tip": "Top set with 2 reps in reserve; reduce load roughly 5–10% for the next two sets."
        },
        {
          "id": "mon_pulldown",
          "name": "Lat Pulldown",
          "sets": 3,
          "reps": "8–12",
          "rest": 90,
          "style": "Arnold",
          "tip": "Pull elbows down and towards your sides; avoid swinging."
        },
        {
          "id": "mon_incline_db",
          "name": "Incline Dumbbell Press",
          "sets": 2,
          "reps": "8–12",
          "rest": 90,
          "style": "Arnold",
          "tip": "Use a gentle incline; keep shoulder blades stable."
        },
        {
          "id": "mon_chest_row",
          "name": "Chest-Supported Row",
          "sets": 3,
          "reps": "8–12",
          "rest": 90,
          "style": "Arnold",
          "tip": "Pause briefly at the top."
        },
        {
          "id": "mon_pecdeck",
          "name": "Pec Deck / Chest Fly",
          "sets": 2,
          "reps": "12–15",
          "rest": 75,
          "style": "Controlled",
          "tip": "Slow stretch; no bouncing."
        },
        {
          "id": "mon_reverse_pec",
          "name": "Reverse Pec Deck",
          "sets": 2,
          "reps": "12–15",
          "rest": 75,
          "style": "Controlled",
          "tip": "Keep elbows soft and shoulders comfortable."
        }
      ]
    },
    {
      "day": "Wednesday",
      "short": "WED",
      "focus": "Legs A + Core",
      "tag": "THE BEAR · LOWER BODY",
      "cardio_target": 10,
