        {
          "id": "tue_calf",
          "name": "Standing Calf Raise",
          "sets": 2,
          "reps": "12–15",
          "rest": 60,
          "style": "Controlled",
          "tip": "Use a comfortable full range."
        },
        {
          "id": "tue_plank",
          "name": "Plank",
          "sets": 2,
          "reps": "20–40 sec",
          "rest": 60,
          "style": "Core",
          "tip": "Record time in the reps field as seconds; weight can be 0."
        }
      ]
    },
    {
